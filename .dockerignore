# Keep the Docker build context small and avoid invalidating layer caches
# with files the image build never reads. See Dockerfile for what actually
# gets COPY'd in (workspace manifests/source + docker/config.toml).

# VCS / editor / agent metadata
.git/
.github/
.vscode/
.claude/

# Build artifacts (rebuilt fresh in-container; also keeps the context small)
/target/
/target-agents/
examples/*/target/

# spec-kit planning artifacts - not needed to build the binary
specs/
.specify/

# Standalone example function crates (each its own [workspace], not a member
# of the root workspace) stay IN the context: examples/*/Dockerfile needs
# repo root as its build context (to reach its sibling `../../crates/*` path
# dependency — see that Dockerfile's own comment), and gcloud/docker builds
# invoked with repo root as context need examples/ present for that. Only
# their build artifacts are excluded above (examples/*/target/).

# Docs
README.ja.md
*.md

# Local scratch / misc
/tmp/
.gitignore
.secretlintignore
.secretlintrc.json
.secretlintrc.local.json
