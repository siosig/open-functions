# Managed by Ansible - local changes will be overwritten.
# Source: ansible/roles/cf_rs/templates/cf-rs.service.j2
# See specs/001-cloud-functions-local/contracts/ops-config.md, section
# "systemd integration", for the rationale behind each setting below.

[Unit]
Description=cf-rs - Cloud Run Functions-compatible local runtime
Documentation=https://github.com/example/cf-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart={{ cf_rs_binary_path }} serve --config {{ cf_rs_config_path }}
Restart=on-failure
TimeoutStopSec={{ cf_rs_shutdown_grace_secs + 10 }}
Delegate=yes
User={{ cf_rs_system_user }}
Group={{ cf_rs_system_group }}
{% if cf_rs_enable_docker %}
SupplementaryGroups=docker
{% endif %}
StateDirectory={{ cf_rs_service_name }}
# Without an explicit mode, systemd defaults StateDirectoryMode to 0755 and
# re-applies it to the state directory every time this unit starts,
# clobbering the 0750 the role's "Create the cf-rs data directory" task
# sets — the two would otherwise fight on every restart, breaking Ansible
# idempotence (Molecule's idempotence check caught exactly this).
StateDirectoryMode=0750
ReadWritePaths={{ cf_rs_data_dir }}
NoNewPrivileges=yes
ProtectSystem=strict
{% if cf_rs_source_dirs | length > 0 %}
ProtectHome=yes
{% for src in cf_rs_source_dirs %}
BindReadOnlyPaths={{ src }}
{% endfor %}
{% else %}
ProtectHome=read-only
{% endif %}
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
